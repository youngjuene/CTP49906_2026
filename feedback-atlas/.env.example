# Copy to .env and fill in. Nothing here has a default that would let the server
# start without you having chosen it.

# Required. There is no fallback: a default admin code is a published admin
# code, and admin mode is the only surface that shows who wrote what.
ATLAS_ADMIN_CODE=

# Required. The pre-registered participant list. Registration is strict --
# an id that is not in this file cannot get in.
ATLAS_ROSTER=roster.csv

# Required for a real class. Generated by scripts/create_access_codes.py.
# This file stores SHA-256 hashes only; keep the cleartext .run/access-codes.csv
# private and send each participant only their own code.
ATLAS_ACCESS_CODES=.run/access-codes.json

# The HTTPS service port. 8888 rather than uvicorn's usual 8000 because 8000 is
# often already taken on a shared workstation; change it here if it clashes.
ATLAS_PORT=8888

# HTTPS is required by default. Set this to 1 only for local development or tests
# on 127.0.0.1; never use it for the classroom URL.
# ATLAS_ALLOW_INSECURE_HTTP=1

# Trusted IP certificate used by scripts/serve.sh for https://143.248.249.7:8888.
# The defaults are shown here so an override is explicit.
ATLAS_TLS_CERT=.run/tls/live/feedback-atlas-ip/fullchain.pem
ATLAS_TLS_KEY=.run/tls/live/feedback-atlas-ip/privkey.pem

# Where the opinions, cached embeddings and last layout live. Keep it on local
# disk: SQLite's WAL mode is unreliable over NFS/SMB.
ATLAS_DB=.run/classroom/atlas.db
# Practice data and public sample codes live only under /demo/.
ATLAS_ENABLE_DEMO=1
ATLAS_DEMO_DB=.run/demo/atlas.db

# embeddinggemma (default) | kure | e5-small-ko
# EmbeddingGemma is a gated download -- see the README's setup step.
ATLAS_EMBEDDING_MODEL=embeddinggemma

# cpu | cuda | mps. CPU is fine: a class produces hundreds of short texts.
ATLAS_DEVICE=cpu

# Main classroom weeks come from the administrator calendar and server timestamp.
ATLAS_AUTO_WEEK=1
# Practice week for demo; also the fallback in explicit legacy/test mode.
ATLAS_DEFAULT_WEEK=1

# Below this many opinions the map is laid out with PCA, at or above it with
# UMAP. Crossing it reorganises the map once -- cross it deliberately between
# sessions rather than mid-presentation.
ATLAS_PCA_UMAP_THRESHOLD=80

# Set to 1 to turn off the Embedding Atlas viewer and serve only the
# hand-written map. The viewer needs duckdb and pyarrow on the server and a
# WebGPU browser on the client; with it off, neither is touched and /data/query
# answers 503.
# ATLAS_DISABLE_VIEWER=1

# Development only. Replaces the embedding model with a deterministic hash, so
# the pipeline runs with no weights and no download. The map it produces is
# meaningless; it is never reachable by mistyping a model name.
# ATLAS_UNSAFE_FAKE_EMBEDDER=1

# Skip the UMAP JIT warm-up. Saves ~10s on a dev restart; never set it for a
# class, or the first submission of the session pays for the compile.
# ATLAS_SKIP_WARMUP=1

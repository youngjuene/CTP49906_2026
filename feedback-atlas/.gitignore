# The repo root .gitignore does not cover .venv, and every subproject here
# carries its own environment (jlens and avllm already need separate ones).
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Runtime state. atlas.db is the live class data: opinions, cached embeddings
# and the last layout. It is deliberately not tracked -- it holds reviewer_id,
# which section 6 of the PRD keeps off every surface it does not have to be on.
*.db
*.db-wal
*.db-shm
.env
roster.csv
# Public fixture required by src/demo.py; classroom rosters remain private.
!demo/roster.csv

# Numba's JIT cache, written by the startup warm-up so the second start skips it.
.numba_cache/

# scripts/class.sh 의 런타임 상태(pid 로그, 터널 주소)
.run/

# The Embedding Atlas build. node_modules is dev-time only and never shipped;
# web/vendor/ is its committed output and MUST stay tracked -- it is what makes
# the frontend work with no npm, no bundler and no network at class time.
frontend/node_modules/

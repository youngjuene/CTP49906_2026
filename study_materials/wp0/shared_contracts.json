  "stable_identifier_invariants": [
    "Identifiers are never reused, retargeted, or silently rewritten.",
    "Filename is never identity.",
    "A hash proves byte association and change history, not truth, authorship, provenance, or rights.",
    "stimulus_id derives from source hash, canonical normalized recipe, and transform schema version.",
    "pair_id, pairing block, donor/source, condition, and congruence are explicit and never inferred from one another.",
    "exchange_artifact_id is opaque and contains no private content hash.",
    "Only an approved Research projection maps exchange/private IDs to investigator-issued study_artifact_id.",
    "session_pseudonym is pseudonymous, never anonymous.",
    "Parent/version links are immutable."
  ],
  "append_only_process": {
    "commands_commit_once_by_unique_command_nonce": true,
    "identical_replay_is_idempotent": true,
    "conflicting_nonce_reuse": "reject",
    "result_attachment": "committed_run_only",
    "reflection_initial_explanation": "immutable_snapshot",
    "edits": "new_linked_revision",
    "prior_serialized_records": "byte_unchanged",
    "withdrawal": "append_state_or_tombstone_never_rewrite_history",
    "private_timing": "exact_local_utc_may_be_retained",
    "research_timing_default": "event_index_and_elapsed_ms"
  },
  "mode_state_machine": {
    "initial_mode": "Teaching",
    "safe_fallback_mode": "Teaching",
    "invalid_config_behavior": "missing, invalid, expired, over-permissive, wrong-version, or unapproved config remains or falls back to Teaching",
    "research_transition_required_fields": [
      "approved_protocol_version",
      "approved_wording_reference",
      "independent_permission_scopes",
      "permitted_fields",
      "destination",
      "retention_period",
      "withdrawal_path",
      "contact",
      "expiry",
      "compatible_schema_version",
      "compatible_course_release_id"
    ],
    "notebook_acknowledgement_is_consent": false,
    "research_fields_available_in_teaching": false,
    "independent_permission_scopes": [
      "process_data_analysis",
      "classroom_or_audience_sharing",
      "quotation_or_reproduction",
      "future_reuse"
    ],
    "authorized_egress": [
      "user_initiated_private_device_download",
      "permission_authorized_blinded_audience_packet",
      "approved_research_mode_minimized_projection"
    ],
    "expected_non_student_data_reads": [
      "repository_code",
      "dependencies",
      "model_weights"
    ],
    "automatic_unapproved_student_data_transmission": false
  },
  "projections": {
    "private_portfolio": {
      "may_include": [
        "content_hashes",
        "aliases",
        "exact_local_history",
        "selected_private_media"
      ],
      "owner": "student_or_creator"
    },
    "audience_packet": {
      "allowlist": "audience_packet.required_fields",
      "reveal_is_monotonic": true,
      "blindness_restorable_after_reveal": false
    },
    "research_projection": {
      "enabled": false,
      "enablement_gate": "approved compatible Research configuration",
      "transformation": "pure_versioned_with_redaction_report",
      "private_input_mutated": false,
      "maximum_allowlist": "approved versioned structural and coded fields only",
      "always_forbidden": [
        "raw_content_hashes",
        "filenames",
        "raw_media",
        "exact_utc",
        "device_metadata",
        "platform_metadata",
        "legal_name",
        "email",
        "uncontrolled_demographics",
        "non_allowlisted_free_text"
      ]
    }
  }
